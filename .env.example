# Populate locally. Never commit credentials.
APP_ORIGIN=https://dinkvision.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_CA_CERT_PATH=
DATABASE_CA_CERT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional local-development override. Deployed builds derive the callback
# from APP_ORIGIN and ignore this override.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SENDER_EMAIL=
# A random 32-byte key encoded as base64. Retain it securely across deployments.
# Encrypts OAuth refresh tokens and resumable upload URLs in the database.
TOKEN_ENCRYPTION_KEY=
VENUE_TIME_ZONE=
# Server-only random secret for /api/jobs/browser. Also set in Vercel.
CRON_SECRET=

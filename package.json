{
  "name": "wrenlabs-pickleball-camera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "account:create": "node --env-file=.env scripts/provision-account.mjs",
    "recorder": "node recorder/cli.mjs",
    "jobs:browser": "node --env-file=.env scripts/browser-jobs.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts recorder/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "onvif": "^0.8.2",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
